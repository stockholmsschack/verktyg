# Copy to .env in the checkout (git-ignored). The portal loads it at startup,
# like Playtime's src/.env; variables already set in the environment win.
# Any portal setting can be set as VERKTYG_<NAME>; lists and dictionaries use
# JSON, and __ sets one key of a dictionary (VERKTYG_JGP_SETTINGS__STATE_DIRECTORY).

# Playtime's OAuth client; take the secret from Playtime's src/.env.
GOOGLE_OAUTH_CLIENT_ID=757030526314-2jdmtf6esodunl71jpm128asj2l3tkbl.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=

# Local debug runs only: uncomment to skip Google sign-in.
# VERKTYG_REQUIRE_AUTH=false

# Production. Debug runs use a fixed key and instance/ instead.
# One persistent random secret for all workers:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# VERKTYG_SECRET_KEY=
# Each tool keeps <tool>/state and <tool>/output here.
# VERKTYG_DATA_DIRECTORY=/var/lib/verktyg
# Which groups may use each tool is edited on the portal's /access page and
# saved in $VERKTYG_DATA_DIRECTORY/access.json (or VERKTYG_ACCESS_FILE).

# Mercure hub for generation progress: the hub in deploy/Caddyfile.local and its
# publisher_jwt. Without the secret, browsers poll. Production's .env, written by
# deploy/production_setup.sh, uses the VPS's internal address and key instead.
VERKTYG_MERCURE_HUB_URL=http://localhost:5000/.well-known/mercure
VERKTYG_MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!
