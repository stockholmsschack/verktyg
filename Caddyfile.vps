playtime.stockholmsschack.se {
	@favicon path /favicon.ico
	handle @favicon {
		root * /opt/playtime/src/web/static
		file_server
	}

	# Frontend static app
	handle_path /ShowTournament/* {
		root * /opt/playtime/public
		file_server
	}

	# Flask static
	handle_path /static/* {
		root * /opt/playtime/src/web/static
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:1612 {
			transport http {
				dial_timeout 2s
			}
		}
	}

	handle_errors {
		@service_down expression {http.error.status_code} in [502, 503, 504]
		root * /var/www/playtime.stockholmsschack.se
		rewrite @service_down /maintenance.html
		file_server
	}

	mercure {
		publisher_jwt !ChangeThisMercureHubJWTSecretKey!
		subscriber_jwt !ChangeThisMercureHubJWTSecretKey!
		anonymous
		cors_origins *
	}
}

http://localhost, http://127.0.0.1 {
	handle_path /.well-known/mercure* {
		mercure {
			publisher_jwt !ChangeThisMercureHubJWTSecretKey!
			subscriber_jwt !ChangeThisMercureHubJWTSecretKey!
			anonymous
			cors_origins *
		}
	}
}

verktyg.stockholmsschack.se {
	handle_path /static/* {
		root * /opt/verktyg/src/verktyg/static
		file_server
	}

	handle_path /tools/jgp/static/* {
		root * /opt/verktyg/tools/jgp/jgp_standings/web/static
		file_server
	}

	handle_path /tools/flickornas/static/* {
		root * /opt/verktyg/tools/flickornas/flickornas_standings/web/static
		file_server
	}

	handle_path /tools/senior/static/* {
		root * /opt/verktyg/tools/senior/senior_gp/web/static
		file_server
	}

	# Browsers subscribe here; the portal publishes through localhost:6002.
	handle /.well-known/mercure* {
		mercure {
			publisher_jwt !ChangeThisMercureHubJWTSecretKey!
			subscriber_jwt !ChangeThisMercureHubJWTSecretKey!
			anonymous
			cors_origins *
		}
	}

	handle {
		reverse_proxy 127.0.0.1:6001 {
			transport http {
				dial_timeout 2s
			}
		}
	}
}

# Verktyg publishes generation progress here. Site blocks with the same
# mercure settings share one hub, so updates reach verktyg's subscribers.
# Kept apart from the localhost block above, which Playtime may use.
http://localhost:6002 {
	handle /.well-known/mercure* {
		mercure {
			publisher_jwt !ChangeThisMercureHubJWTSecretKey!
			subscriber_jwt !ChangeThisMercureHubJWTSecretKey!
			anonymous
			cors_origins *
		}
	}
}

verkstad.stockholmsschack.se {
    log {
        output stderr
        format console
    }
	@favicon path /favicon.ico
	handle @favicon {
		root * /opt/playtime-verkstad/src/web/static
		file_server
	}
	handle_path /ShowTournament/* {
		root * /opt/playtime-verkstad/public
		file_server
	}
	handle_path /static/* {
		root * /opt/playtime-verkstad/src/web/static
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:1613 {
			transport http {
				dial_timeout 2s
			}
		}
	}

	mercure {
		publisher_jwt !ChangeThisMercureHubJWTSecretKey-different-secret
		subscriber_jwt !ChangeThisMercureHubJWTSecretKey-different-secret
		anonymous
		cors_origins *
		# if prod uses a bolt transport, give this one its own file:
		# transport bolt { path /var/lib/caddy/mercure-verkstad.db }
	}
}

www.movingredbus.net {
	redir https://movingredbus.net{uri} 301
}

movingredbus.net {
	root * /var/www/movingredbus.net
	file_server
}

